# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Virtualenvs
.venv/
.venv-interactive-swe/

# Repository checkouts created by the minimal interactive launcher
.experiment-checkouts/

# Immutable experiment logs. The dashboard is built to index.html at the repo
# root instead of into this directory, so the whole thing stays ignored and the
# published page never drags the raw run artifacts along with it.
.experiment-logs/

# Large dataset binary — the immutable research input, stored separately (not in git
# history). Keep the human-readable schema/README for reference.
data/interactive-swe/test/*.arrow

